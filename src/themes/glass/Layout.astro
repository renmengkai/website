---
import { ViewTransitions } from 'astro:transitions';
import Header from './components/Header.astro';
import Footer from './components/Footer.astro';
import '../../styles/glass.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = '个人博客与作品集 - 记录技术探索与创意实现',
  image = '/og-image.png'
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="zh-CN" class="theme-glass">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#050505" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- 尽早标记 JS 可用，动效初始态仅在 html.js 下生效（无 JS 时内容始终可见） -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- 字体：Space Grotesk 展示 + Plus Jakarta Sans 正文 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"></noscript>

    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body class="min-h-screen flex flex-col bg-void">
    <!-- 噪点颗粒覆盖层 -->
    <div class="noise-overlay" aria-hidden="true"></div>

    <!-- 全局页面过渡骨架屏 -->
    <div class="page-transition-skeleton fixed inset-0 z-50 bg-void" style="display: none;">
      <div class="skeleton-animate">
        <!-- Header 骨架 -->
        <div class="h-20 flex items-center justify-center">
          <div class="h-12 w-[28rem] max-w-[90%] skeleton-block rounded-full"></div>
        </div>

        <!-- 内容骨架 -->
        <div class="max-w-4xl mx-auto px-6 py-20">
          <div class="flex justify-center gap-2 mb-6">
            <div class="h-6 w-16 skeleton-block rounded-full"></div>
            <div class="h-6 w-20 skeleton-block rounded-full"></div>
          </div>

          <div class="max-w-2xl mx-auto mb-6 space-y-3">
            <div class="h-10 skeleton-block w-full"></div>
            <div class="h-10 skeleton-block w-3/4 mx-auto"></div>
          </div>

          <div class="flex items-center justify-center gap-4 mb-12">
            <div class="w-8 h-8 skeleton-block rounded-full"></div>
            <div class="h-4 w-20 skeleton-block"></div>
            <div class="h-4 w-4 skeleton-block"></div>
            <div class="h-4 w-24 skeleton-block"></div>
          </div>

          <div class="mb-12 rounded-3xl overflow-hidden">
            <div class="w-full aspect-video skeleton-block rounded-3xl"></div>
          </div>

          <div class="space-y-4">
            <div class="space-y-2">
              <div class="h-4 skeleton-block w-full"></div>
              <div class="h-4 skeleton-block w-11/12"></div>
              <div class="h-4 skeleton-block w-10/12"></div>
            </div>
            <div class="pt-4">
              <div class="h-7 skeleton-block w-1/3"></div>
            </div>
            <div class="space-y-2">
              <div class="h-4 skeleton-block w-full"></div>
              <div class="h-4 skeleton-block w-full"></div>
              <div class="h-4 skeleton-block w-9/12"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <Header currentPath={currentPath} />

    <main class="flex-1">
      <slot />
    </main>

    <Footer />

    <!-- 骨架屏状态管理 -->
    <script is:inline>
      document.addEventListener('astro:page-load', () => {
        document.documentElement.classList.remove('is-loading');
      });

      document.addEventListener('astro:before-preparation', () => {
        document.documentElement.classList.add('is-loading');
      });
    </script>

    <!-- 全站动效初始化（View Transitions 下每次导航重新执行） -->
    <script>
      import { initMotion } from '../../lib/motion';
      initMotion();
      document.addEventListener('astro:page-load', initMotion);
    </script>

    <!-- 首访自动检测：无 design cookie 时按系统配色选择设计（本布局为 glass/深色） -->
    <script is:inline>
      (function () {
        if (!/(?:^|; )design=/.test(document.cookie)) {
          var t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'glass' : 'vima';
          document.cookie = 'design=' + t + ';path=/;max-age=31536000;samesite=lax';
          if (t !== 'glass') location.reload();
        }
      })();
    </script>
  </body>
</html>
