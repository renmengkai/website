---
// 博客文章骨架屏组件 - 用于预加载时展示（深色玻璃基调）
---

<div class="skeleton-container animate-pulse">
  <!-- 分类骨架 -->
  <div class="flex flex-wrap justify-center gap-2 mb-6">
    <div class="h-6 w-16 bg-white/[0.06] rounded-full"></div>
    <div class="h-6 w-20 bg-white/[0.06] rounded-full"></div>
  </div>

  <!-- 标题骨架 -->
  <div class="max-w-2xl mx-auto mb-6 space-y-3">
    <div class="h-10 skeleton-block w-full"></div>
    <div class="h-10 skeleton-block w-3/4 mx-auto"></div>
  </div>

  <!-- 元信息骨架 -->
  <div class="flex items-center justify-center gap-4 mb-12">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 bg-white/[0.06] rounded-full"></div>
      <div class="h-4 w-20 skeleton-block"></div>
    </div>
    <div class="h-4 w-4 skeleton-block"></div>
    <div class="h-4 w-24 skeleton-block"></div>
  </div>

  <!-- 封面图骨架 -->
  <div class="max-w-4xl mx-auto mb-12 rounded-3xl overflow-hidden border border-white/10">
    <div class="w-full aspect-video bg-white/[0.05]"></div>
  </div>

  <!-- 文章内容骨架 -->
  <div class="max-w-3xl mx-auto space-y-4">
    <!-- 段落骨架 -->
    <div class="space-y-2">
      <div class="h-4 skeleton-block w-full"></div>
      <div class="h-4 skeleton-block w-11/12"></div>
      <div class="h-4 skeleton-block w-10/12"></div>
    </div>

    <!-- 标题骨架 -->
    <div class="pt-4">
      <div class="h-7 skeleton-block w-1/3"></div>
    </div>

    <!-- 更多段落骨架 -->
    <div class="space-y-2">
      <div class="h-4 skeleton-block w-full"></div>
      <div class="h-4 skeleton-block w-full"></div>
      <div class="h-4 skeleton-block w-9/12"></div>
    </div>

    <!-- 代码块骨架 -->
    <div class="rounded-2xl overflow-hidden border border-white/10">
      <div class="bg-white/[0.04] px-4 py-2.5 border-b border-white/10">
        <div class="h-4 w-20 skeleton-block"></div>
      </div>
      <div class="bg-void-panel p-4 space-y-2">
        <div class="h-4 bg-white/[0.08] rounded w-3/4"></div>
        <div class="h-4 bg-white/[0.08] rounded w-1/2"></div>
        <div class="h-4 bg-white/[0.08] rounded w-5/6"></div>
        <div class="h-4 bg-white/[0.08] rounded w-2/3"></div>
      </div>
    </div>

    <!-- 更多内容骨架 -->
    <div class="space-y-2">
      <div class="h-4 skeleton-block w-full"></div>
      <div class="h-4 skeleton-block w-10/12"></div>
      <div class="h-4 skeleton-block w-full"></div>
    </div>

    <!-- 列表骨架 -->
    <div class="pl-6 space-y-2">
      <div class="flex items-center gap-2">
        <div class="w-2 h-2 bg-white/[0.06] rounded-full"></div>
        <div class="h-4 skeleton-block w-3/4"></div>
      </div>
      <div class="flex items-center gap-2">
        <div class="w-2 h-2 bg-white/[0.06] rounded-full"></div>
        <div class="h-4 skeleton-block w-2/3"></div>
      </div>
      <div class="flex items-center gap-2">
        <div class="w-2 h-2 bg-white/[0.06] rounded-full"></div>
        <div class="h-4 skeleton-block w-4/5"></div>
      </div>
    </div>

    <!-- 最后段落骨架 -->
    <div class="space-y-2">
      <div class="h-4 skeleton-block w-full"></div>
      <div class="h-4 skeleton-block w-7/12"></div>
    </div>
  </div>
</div>

<style>
  .skeleton-container {
    min-height: 60vh;
  }

  @keyframes shimmer {
    0% {
      background-position: -200% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }

  .animate-pulse > div {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }
</style>
