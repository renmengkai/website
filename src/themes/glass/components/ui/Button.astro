---
// 按钮组件 - 岛式胶囊：主按钮为绿色实心，箭头嵌套在独立圆形容器内
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  showArrow?: boolean;
  magnetic?: boolean;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  class: className = '',
  type = 'button',
  showArrow = false,
  magnetic = false
} = Astro.props;

const Tag = href ? 'a' : 'button';

const variants = {
  primary: 'bg-primary-500 text-void font-semibold hover:bg-primary-400 hover:shadow-glow',
  secondary: 'bg-white/[0.05] text-fg border border-white/10 hover:bg-white/[0.09] hover:border-white/20',
  ghost: 'bg-transparent text-fg-soft hover:text-fg hover:bg-white/[0.06]',
  outline: 'border border-primary-500/40 text-primary-400 hover:bg-primary-500/10 hover:border-primary-500/60'
};

// 嵌套圆形箭头容器的配色
const arrowWrap = {
  primary: 'bg-void/15',
  secondary: 'bg-white/[0.08]',
  ghost: 'bg-white/[0.08]',
  outline: 'bg-primary-500/15'
};

const sizes = {
  sm: showArrow ? 'pl-4 pr-1.5 py-1.5 text-sm' : 'px-4 py-2 text-sm',
  md: showArrow ? 'pl-6 pr-2 py-2 text-base' : 'px-6 py-3 text-base',
  lg: showArrow ? 'pl-8 pr-2.5 py-2.5 text-lg' : 'px-8 py-4 text-lg'
};

const arrowSizes = {
  sm: 'w-6 h-6',
  md: 'w-8 h-8',
  lg: 'w-10 h-10'
};
---

<Tag
  href={href}
  type={!href ? type : undefined}
  data-magnetic={magnetic ? '' : undefined}
  class:list={[
    'group inline-flex items-center justify-center gap-2.5 rounded-full',
    !magnetic && 'transition-all duration-500 ease-spring',
    'active:scale-[0.98]',
    'focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500/70 focus-visible:ring-offset-2 focus-visible:ring-offset-void',
    variants[variant],
    sizes[size],
    className
  ]}
>
  <slot />
  {showArrow && (
    <span class:list={[
      'rounded-full flex items-center justify-center shrink-0',
      'transition-transform duration-500 ease-spring',
      'group-hover:translate-x-0.5 group-hover:-translate-y-px group-hover:scale-105',
      arrowWrap[variant],
      arrowSizes[size]
    ]}>
      <svg class="w-[45%] h-[45%]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </span>
  )}
</Tag>
