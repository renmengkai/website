---
// 徽章组件 - 深色玻璃质感
interface Props {
  variant?: 'default' | 'primary' | 'dark' | 'success' | 'warning';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const {
  variant = 'default',
  size = 'md',
  class: className = ''
} = Astro.props;

const variants = {
  default: 'bg-white/[0.05] text-fg-soft border border-white/10',
  primary: 'bg-primary-500/10 text-primary-400 border border-primary-500/25',
  dark: 'bg-void-panel text-fg border border-white/10',
  success: 'bg-primary-500/10 text-primary-400 border border-primary-500/25',
  warning: 'bg-amber-400/10 text-amber-300 border border-amber-400/25'
};

const sizes = {
  sm: 'px-2.5 py-1 text-xs',
  md: 'px-3 py-1.5 text-sm',
  lg: 'px-4 py-2 text-sm'
};
---

<span
  class:list={[
    'inline-flex items-center font-medium rounded-full',
    variants[variant],
    sizes[size],
    className
  ]}
>
  <slot />
</span>
