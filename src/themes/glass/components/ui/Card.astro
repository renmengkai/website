---
// 卡片组件 - 双层 Bezel 玻璃结构：外壳托盘 + 内核面板
// 外壳带发丝环，内核带顶部高光，hover 时外壳出现绿色辉光
interface Props {
  href?: string;
  class?: string;
  hover?: boolean;
  padding?: 'sm' | 'md' | 'lg';
}

const {
  href,
  class: className = '',
  hover = true,
  padding = 'md'
} = Astro.props;

const Tag = href ? 'a' : 'div';

const paddings = {
  sm: 'p-4',
  md: 'p-6',
  lg: 'p-8'
};
---

<Tag
  href={href}
  data-spotlight={hover ? '' : undefined}
  class:list={[
    'bezel block group/card',
    'transition-[box-shadow,transform] duration-500 ease-out-expo',
    hover && 'hover:-translate-y-1.5 hover:shadow-glow-sm',
    hover && href && 'cursor-pointer',
    className
  ]}
>
  <div class:list={['bezel-core overflow-hidden', paddings[padding]]}>
    <slot />
  </div>
</Tag>
