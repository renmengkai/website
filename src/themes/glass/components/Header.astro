---
// Header 组件 - 悬浮玻璃胶囊岛式导航（下滑收起、上滑出现）

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: '首页' },
  { href: '/blog', label: '博客' },
  { href: '/projects', label: '作品' },
  { href: '/about', label: '关于' },
];

// 判断当前路径是否匹配导航项
function isActive(href: string): boolean {
  if (href === '/') {
    return currentPath === '/';
  }
  return currentPath.startsWith(href);
}
---

<header class="fixed top-0 left-0 right-0 z-50 flex justify-center px-4 pt-4 lg:pt-6 pointer-events-none" id="main-header">
  <nav class="pointer-events-auto flex items-center gap-1 sm:gap-2 rounded-full border border-white/10 bg-void/70 backdrop-blur-xl pl-4 pr-2 py-2 shadow-depth">
    <!-- Logo -->
    <a
      href="/"
      class="flex items-center mr-2 hover:opacity-80 transition-opacity"
      aria-label="返回首页"
    >
      <img src="/favicon.svg" alt="RMK" class="h-7" />
    </a>

    <!-- 桌面端导航 -->
    <div class="hidden md:flex items-center">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`nav-underline mx-3 text-sm font-medium transition-colors duration-300
            ${isActive(link.href)
              ? 'is-active text-fg'
              : 'text-fg-faint hover:text-fg'
            }`}
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- CTA：胶囊按钮 + 嵌套圆形箭头 -->
    <a
      href="/contact"
      data-magnetic
      class="group hidden sm:inline-flex items-center gap-2.5 ml-2 bg-primary-500 text-void pl-5 pr-1.5 py-1.5 rounded-full text-sm font-semibold hover:bg-primary-400 hover:shadow-glow-sm active:scale-[0.98]"
    >
      联系我们
      <span class="w-7 h-7 rounded-full bg-void/15 flex items-center justify-center transition-transform duration-500 ease-spring group-hover:translate-x-0.5 group-hover:scale-105">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </span>
    </a>

    <!-- 设计切换：太阳图标 → 浅色 vima 设计 -->
    <button
      class="hidden md:inline-flex items-center justify-center w-9 h-9 ml-1 rounded-full border border-white/10 text-fg-soft hover:text-primary-400 hover:border-primary-400/40 transition-colors duration-300"
      aria-label="切换到浅色设计"
      onclick="document.cookie='design=vima;path=/;max-age=31536000;samesite=lax';location.reload()"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
      </svg>
    </button>

    <!-- 移动端菜单按钮（汉堡 → X 形变） -->
    <button
      class="md:hidden relative w-9 h-9 ml-1 rounded-full hover:bg-white/[0.06] transition-colors"
      id="mobile-menu-btn"
      aria-label="打开菜单"
      aria-expanded="false"
    >
      <span class="menu-bar absolute left-1/2 top-1/2 -ml-2.5 -mt-[4px] w-5 h-[1.5px] bg-fg rounded-full"></span>
      <span class="menu-bar absolute left-1/2 top-1/2 -ml-2.5 mt-[3px] w-5 h-[1.5px] bg-fg rounded-full"></span>
    </button>
  </nav>
</header>

<!-- 移动端全屏玻璃菜单 -->
<div
  class="md:hidden fixed inset-0 z-40 invisible opacity-0 transition-[opacity,visibility] duration-500 ease-spring bg-void/85 backdrop-blur-2xl"
  id="mobile-menu"
  aria-hidden="true"
>
  <div class="min-h-[100dvh] flex flex-col justify-center px-10">
    <nav class="space-y-2">
      {navLinks.map((link, i) => (
        <div class="overflow-hidden">
          <a
            href={link.href}
            class={`menu-item block font-display text-4xl font-bold py-2 transition-[transform,opacity] duration-700 ease-spring translate-y-12 opacity-0
              ${isActive(link.href) ? 'text-primary-400' : 'text-fg hover:text-primary-400'}`}
            style={`transition-delay: ${80 + i * 60}ms;`}
          >
            <span class="font-mono text-sm text-fg-ghost mr-4 align-middle">0{i + 1}</span>
            {link.label}
          </a>
        </div>
      ))}
    </nav>

    <div class="mt-14 overflow-hidden">
      <a
        href="/contact"
        class="menu-item group inline-flex items-center gap-3 bg-primary-500 text-void pl-6 pr-2 py-2 rounded-full text-base font-semibold transition-[transform,opacity] duration-700 ease-spring translate-y-12 opacity-0"
        style="transition-delay: 340ms;"
      >
        联系我们
        <span class="w-8 h-8 rounded-full bg-void/15 flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </span>
      </a>
    </div>

    <!-- 设计切换：太阳图标 → 浅色 vima 设计 -->
    <div class="mt-6 overflow-hidden">
      <button
        class="menu-item inline-flex items-center justify-center w-9 h-9 rounded-full border border-white/10 text-fg-soft hover:text-primary-400 hover:border-primary-400/40 transition-[transform,opacity] duration-700 ease-spring translate-y-12 opacity-0"
        style="transition-delay: 400ms;"
        aria-label="切换到浅色设计"
        onclick="document.cookie='design=vima;path=/;max-age=31536000;samesite=lax';location.reload()"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
  .menu-bar {
    transition: transform 0.45s cubic-bezier(0.32, 0.72, 0, 1);
  }

  #mobile-menu-btn[aria-expanded='true'] .menu-bar:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  #mobile-menu-btn[aria-expanded='true'] .menu-bar:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  #mobile-menu.menu-open {
    visibility: visible;
    opacity: 1;
  }

  #mobile-menu.menu-open .menu-item {
    transform: translateY(0);
    opacity: 1;
  }
</style>

<script>
  function initMobileMenu() {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (!menuBtn || !menu || menuBtn.dataset.bound) return;
    menuBtn.dataset.bound = '1';

    const setOpen = (open: boolean) => {
      menu.classList.toggle('menu-open', open);
      menu.setAttribute('aria-hidden', String(!open));
      menuBtn.setAttribute('aria-expanded', String(open));
      menuBtn.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
      document.body.style.overflow = open ? 'hidden' : '';
    };

    menuBtn.addEventListener('click', () => {
      setOpen(!menu.classList.contains('menu-open'));
    });

    // 点击菜单链接后关闭
    menu.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => setOpen(false));
    });
  }

  initMobileMenu();
  document.addEventListener('astro:page-load', initMobileMenu);
</script>
