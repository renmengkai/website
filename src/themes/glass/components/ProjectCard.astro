---
// 项目卡片组件 - 深色玻璃
import Card from './ui/Card.astro';

interface Props {
  title: string;
  description: string;
  slug: { current: string };
  thumbnail?: string;
  technologies?: string[];
  featured?: boolean;
}

const { title, description, slug, thumbnail, technologies = [], featured = false } = Astro.props;
---

<Card href={`/projects/${slug.current}`} class="group relative">
  <!-- 精选标记 -->
  {featured && (
    <div class="absolute top-5 right-5 z-10">
      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-void/70 backdrop-blur-sm text-primary-400 border border-primary-500/30">
        <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        精选
      </span>
    </div>
  )}

  <!-- 缩略图 -->
  {thumbnail && (
    <div class="relative -mx-6 -mt-6 mb-5 overflow-hidden">
      <div class="aspect-video bg-white/[0.03] overflow-hidden">
        <img
          src={thumbnail}
          alt={title}
          width={800}
          height={450}
          class="w-full h-full object-cover transition-transform duration-700 ease-out-expo group-hover:scale-[1.06]"
          loading="lazy"
        />
      </div>
      <div class="absolute inset-x-0 bottom-0 h-12 bg-gradient-to-t from-void-panel/70 to-transparent pointer-events-none"></div>
    </div>
  )}

  <!-- 标题 -->
  <h3 class="text-lg font-semibold text-fg mb-2 transition-colors duration-300 group-hover:text-primary-400">
    {title}
  </h3>

  <!-- 描述 -->
  <p class="text-fg-faint text-sm leading-relaxed mb-4 line-clamp-2">
    {description}
  </p>

  <!-- 技术栈标签 -->
  {technologies.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {technologies.slice(0, 4).map((tech) => (
        <span class="inline-block px-2.5 py-1 rounded-full text-xs font-medium font-mono bg-white/[0.05] text-fg-soft border border-white/10">
          {tech}
        </span>
      ))}
      {technologies.length > 4 && (
        <span class="inline-block px-2.5 py-1 rounded-full text-xs font-medium bg-white/[0.05] text-fg-ghost border border-white/10">
          +{technologies.length - 4}
        </span>
      )}
    </div>
  )}

  <!-- 查看更多指示 -->
  <div class="mt-4 flex items-center gap-1.5 text-sm text-primary-400
              opacity-0 -translate-x-2 transition-all duration-500 ease-out-expo
              group-hover:opacity-100 group-hover:translate-x-0">
    查看详情
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
    </svg>
  </div>
</Card>
