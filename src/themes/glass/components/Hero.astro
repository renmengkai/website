---
// Hero Section - 深空电影感：辉光大字 + 逐行遮罩入场 + 能力 Marquee + 玻璃统计卡
import projectTypes from '../../../data/projectTypes.json';

interface Props {
  title: string;
  /** 可选：手动分行以获得逐行入场效果，缺省时整体为一行 */
  titleLines?: string[];
  subtitle?: string;
  description?: string;
  showCTA?: boolean;
  centered?: boolean;
}

const {
  title,
  titleLines,
  description,
  showCTA = true,
  centered = true
} = Astro.props;

const lines = titleLines && titleLines.length > 0 ? titleLines : [title];

// 能力标签：无限滚动 Marquee
const capabilities = [
  'AI Agent 工具开发',
  '多智能体编排',
  '80% 工作由 AI 完成',
  '降本增效',
  '招商合作共赢',
  'LLM 应用落地',
];

const heroCards = projectTypes.hero.cards;

const iconMap: Record<string, string> = {
  globe: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>`,
  check: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
  sparkles: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>`,
  github: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>`,
  agent: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
  '传播': `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>`
};
---

<section class="relative min-h-[100dvh] flex items-center overflow-hidden">
  <!-- 网格线背景 -->
  <div class="absolute inset-0 bg-grid-dark pointer-events-none" aria-hidden="true"></div>

  <!-- 环境光晕轨道球 -->
  <div class="orb orb-primary animate-orb-drift -top-40 left-1/2 -translate-x-1/2 w-[56rem] h-[36rem]" aria-hidden="true"></div>
  <div class="orb orb-teal -bottom-40 -left-40 w-[36rem] h-[36rem]" aria-hidden="true"></div>

  <div class={`container-custom relative w-full min-w-0 ${centered ? 'text-center' : ''}`}>
    <div class={`${centered ? 'max-w-5xl mx-auto' : 'max-w-3xl'} pt-32 pb-8`}>
      <!-- 眉题：状态点 -->
      <div class="eyebrow mb-10" data-reveal>
        <span class="relative flex h-2 w-2">
          <span class="animate-ping-slow absolute inline-flex h-full w-full rounded-full bg-primary-500 opacity-60"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-primary-500 shadow-glow-sm"></span>
        </span>
        AI Agent 驱动 · 正在接洽新项目
      </div>

      <!-- 主标题：逐行遮罩入场，末行渐变辉光 -->
      <h1
        class="text-display-xl font-bold text-fg mb-8"
        data-reveal-lines
      >
        {lines.map((line, i) => (
          <span class="reveal-line">
            <span
              class={i === lines.length - 1 && lines.length > 1 ? 'text-glow-gradient' : ''}
              style={`--line-index: ${i + 1};`}
            >
              {line}
            </span>
          </span>
        ))}
      </h1>

      <!-- 描述 -->
      {description && (
        <p
          class="text-lg lg:text-xl text-fg-faint max-w-2xl mx-auto mb-12 leading-relaxed"
          data-reveal
          style="--reveal-delay: 350ms;"
        >
          {description}
        </p>
      )}

      <!-- CTA 按钮：岛式胶囊 -->
      {showCTA && (
        <div
          class="flex flex-wrap items-center justify-center gap-4"
          data-reveal
          style="--reveal-delay: 500ms;"
        >
          <a
            href="/projects"
            data-magnetic
            class="group inline-flex items-center gap-3 bg-primary-500 text-void pl-7 pr-2 py-2 rounded-full text-base font-semibold hover:bg-primary-400 hover:shadow-glow active:scale-[0.98]"
          >
            查看作品
            <span class="w-9 h-9 rounded-full bg-void/15 flex items-center justify-center transition-transform duration-500 ease-spring group-hover:translate-x-0.5 group-hover:-translate-y-px group-hover:scale-105">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </span>
          </a>
          <a
            href="/about"
            data-magnetic
            class="group inline-flex items-center gap-3 bg-white/[0.05] text-fg border border-white/10 pl-7 pr-2 py-2 rounded-full text-base font-medium hover:bg-white/[0.09] hover:border-white/20 active:scale-[0.98]"
          >
            了解更多
            <span class="w-9 h-9 rounded-full bg-white/[0.08] flex items-center justify-center transition-transform duration-500 ease-spring group-hover:translate-x-0.5 group-hover:-translate-y-px group-hover:scale-105">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </span>
          </a>
        </div>
      )}

      <!-- 能力标签 Marquee -->
      <div class="marquee mt-16" data-reveal style="--reveal-delay: 650ms;" aria-label="核心能力">
        <div class="marquee-track">
          {[...capabilities, ...capabilities].map((cap) => (
            <span class="inline-flex items-center gap-3 px-6 py-2.5 text-sm text-fg-faint whitespace-nowrap font-mono">
              <span class="text-primary-500/70 text-[10px]" aria-hidden="true">◆</span>
              {cap}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- 底部统计卡片区域：玻璃 Bezel 卡 -->
    <div class="hidden lg:block mt-14">
      <div class="flex justify-center gap-5">
        {heroCards.map((card: any, i: number) => {
          const iconSvg = iconMap[card.icon || 'globe'];
          const revealDelay = `--reveal-delay: ${700 + i * 120}ms;`;
          return (
            <div
              class="bezel w-[300px] transition-[box-shadow,transform] duration-500 ease-out-expo hover:-translate-y-1 hover:shadow-glow-sm"
              data-reveal
              data-spotlight
              style={revealDelay}
            >
              <div class="bezel-core p-5 h-[168px] flex flex-col text-left">
                {card.type === 'stats' && (
                  <>
                    <div class="flex items-center justify-between h-9">
                      <div class="w-9 h-9 rounded-xl bg-white/[0.05] border border-white/10 flex items-center justify-center text-fg-soft">
                        <Fragment set:html={iconSvg} />
                      </div>
                      <span class="text-xs text-primary-400 flex items-center gap-0.5 font-medium bg-primary-500/10 border border-primary-500/20 px-2 py-1 rounded-full">
                        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d={card.trendType === 'up' ? "M12 19V5m-7 7l7-7 7 7" : "M12 5v14m-7-7l7 7 7-7"} />
                        </svg>
                        {card.trend}
                      </span>
                    </div>
                    <div class="h-6 flex items-center mt-4">
                      <span class="text-sm text-fg-faint">{card.label}</span>
                    </div>
                    <div class="h-12 flex items-center mt-2">
                      <span class="text-3xl font-bold text-fg mr-2 font-display" data-stat data-count-to={card.value}>{card.value}</span>
                      <span class="text-xs text-fg-ghost pt-1.5">{card.description}</span>
                    </div>
                  </>
                )}
                {card.type === 'default' && (
                  <>
                    <div class="flex items-center justify-between h-9">
                      <div class="w-9 h-9 rounded-xl bg-white/[0.05] border border-white/10 flex items-center justify-center text-fg-soft">
                        <Fragment set:html={iconSvg} />
                      </div>
                    </div>
                    <div class="h-6 flex items-center mt-4">
                      <span class="text-sm text-fg-faint">{card.label}</span>
                    </div>
                    <div class="h-12 flex items-center mt-2">
                      <span class="text-xs text-fg-ghost">{card.description}</span>
                    </div>
                  </>
                )}
                {card.type === 'tags' && (
                  <>
                    <div class="flex items-center justify-between h-9">
                      <div class="w-9 h-9 rounded-xl bg-white/[0.05] border border-white/10 flex items-center justify-center text-fg-soft">
                        <Fragment set:html={iconSvg} />
                      </div>
                    </div>
                    <div class="h-6 flex items-center mt-4">
                      <span class="text-sm font-medium text-fg">{card.label}</span>
                    </div>
                    <div class="h-12 flex items-center mt-2">
                      <div class="flex gap-2 flex-nowrap overflow-hidden">
                        {card.tags.map((tag: { label: string; active: boolean }) => (
                          <span class={`px-3 py-1.5 rounded-full text-xs font-medium shrink-0 ${tag.active ? 'bg-primary-500/10 text-primary-400 border border-primary-500/25' : 'bg-white/[0.05] text-fg-faint border border-white/10'}`}>
                            {tag.label}
                          </span>
                        ))}
                      </div>
                    </div>
                  </>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- 滚动指示 -->
    <div
      class="hidden lg:flex mt-14 pb-4 flex-col items-center gap-2 text-fg-ghost"
      data-reveal
      style="--reveal-delay: 1100ms;"
      aria-hidden="true"
    >
      <span class="text-[10px] tracking-[0.24em] uppercase font-mono">Scroll</span>
      <span class="scroll-hint block w-px h-9 bg-gradient-to-b from-primary-500/60 to-transparent"></span>
    </div>
  </div>
</section>

<style>
  .scroll-hint {
    animation: scroll-hint 2.2s cubic-bezier(0.16, 1, 0.3, 1) infinite;
    transform-origin: top center;
  }

  @keyframes scroll-hint {
    0% { transform: scaleY(0); }
    50% { transform: scaleY(1); }
    100% { transform: scaleY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-hint {
      animation: none;
    }
  }
</style>
