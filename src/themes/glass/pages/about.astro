---
import Layout from '../Layout.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';

// 关于页面数据
const about = {
  name: '任孟锴',
  title: '创始人 & CEO',
  quote: 'AI时代已经到来，我们致力于用AI Agent技术帮助企业降本增效。在我们团队中，80%的工作由AI Agent完成，这让我们能够以更高的效率、更低的成本为客户创造价值。我们相信，选择我们，将是您在未来10年内做出的最好决策。',
};

// 核心价值观
const values = [
  {
    icon: 'innovation',
    title: 'AI驱动',
    description: '80%工作由AI Agent完成，以最高效率交付卓越成果。'
  },
  {
    icon: 'integrity',
    title: '合作共赢',
    description: '招商合作，与合作伙伴共同成长，在AI时代携手领先。'
  },
  {
    icon: 'customer',
    title: '降本增效',
    description: '帮助企业适应时代变化，实现数字化转型与效率提升。'
  }
];

// 统计数据
const stats = [
  { value: '80%', label: '工作由AI Agent完成' },
  { value: '10年', label: '未来领先的选择' },
  { value: '24*7', label: '全天候AI协作' }
];

// 仅用于展示层：把 "80%" 这类字符串拆成数字 + 后缀，供 data-count-to 滚动计数
const parseStat = (v: string) => {
  const m = v.match(/^(\d+(?:\.\d+)?)(.*)$/);
  return m ? { num: m[1], suffix: m[2] } : null;
};

// 团队来源
const companies = ['美团', '京东', '小米', '华为'];

// 技术栈
const techStack = [
  {
    name: 'Web 开发',
    icon: 'web',
    languages: ['TypeScript', 'JavaScript', 'Go', 'Rust'],
    frameworks: ['Vue/Nuxt', 'Node.js', 'Astro'],
    percent: 45
  },
  {
    name: '跨端应用',
    icon: 'mobile',
    languages: ['TypeScript', 'JavaScript', 'Python'],
    frameworks: ['微信小程序', 'React Native', 'Tauri'],
    percent: 30
  },
  {
    name: '工具与 CLI',
    icon: 'cli',
    languages: ['Rust', 'Go', 'Python', 'TypeScript'],
    frameworks: ['Clap', 'Cobra', 'Raycast'],
    percent: 25
  }
];

// FAQ 数据
const faqs = [
  {
    question: '你们擅长哪些技术？',
    answer: '我们精通多种编程语言：Python、JavaScript、Java、Go、Rust，以及前端框架Vue、React、Tauri、Electron等。我们在AI Agent开发和多智能体编排方面具有深厚的专业知识。'
  },
  {
    question: 'AI Agent能完成哪些工作？',
    answer: '在我们团队中，80%的工作由AI Agent完成，包括代码编写、测试、文档生成、数据分析、自动化流程等。这让我们的开发效率大幅提升，同时降低成本。'
  },
  {
    question: '你们提供哪些服务？',
    answer: '我们专注于开发AI Agent工具和Agent Team编排工具，帮助企业构建智能化的工作流程，实现降本增效。我们提供从咨询到实施的完整解决方案。'
  },
  {
    question: '如何与你们合作？',
    answer: '我们目前处于创业阶段，诚挚邀请招商合作。无论您是希望采用AI技术的企业，还是寻求合作的伙伴，我们都欢迎与您洽谈，共同在AI时代领先发展。'
  },
  {
    question: '与传统开发团队相比，你们有什么优势？',
    answer: '我们80%的工作由AI Agent完成，这意味着更高的开发效率、更低的成本和更快的交付速度。我们将节省的成本回馈给客户，让中小企业也能享受到AI时代的红利。'
  },
  {
    question: '你们的收费模式是怎样的？',
    answer: '我们提供灵活的收费模式：根据项目复杂度和工作量定价，可选择按项目打包或按工时计费。具体方案可根据您的需求定制，欢迎联系我们获取详细报价。'
  },
  {
    question: '你们目前做过哪些类型的项目？',
    answer: '我们主要专注于企业内部工具、Agent编排平台、数据分析自动化等工作场景。项目覆盖金融、医疗、电商等多个行业，具备丰富的跨行业落地经验。'
  },
  {
    question: '如何开始合作？',
    answer: '您可以通过网站联系我们，说明您的需求和应用场景。我们会在24小时内回复，进行初步沟通后安排线上或线下会议，深入了解需求后提供解决方案和报价。'
  }
];
---

<Layout
  title="关于 - RMK"
  description="了解更多关于我们的背景、价值观和团队"
>
  <!-- Hero 区域：页面骨架模板 -->
  <section class="relative pt-32 pb-16 lg:pb-24 overflow-hidden">
    <div class="absolute inset-0 bg-grid-dark pointer-events-none" aria-hidden="true"></div>
    <div class="orb orb-primary -top-40 left-1/2 -translate-x-1/2 w-[48rem] h-[30rem]" aria-hidden="true"></div>
    <div class="container-custom relative text-center">
      <p class="eyebrow mb-8" data-reveal>关于我们</p>
      <h1 class="text-display-lg font-bold text-fg mb-6" data-reveal-lines>
        <span class="reveal-line"><span style="--line-index: 1;">AI时代的创新团队</span></span>
      </h1>
      <p class="text-lg lg:text-xl text-fg-faint max-w-2xl mx-auto" data-reveal style="--reveal-delay: 300ms;">
        专注AI Agent工具与多智能体编排，助力企业降本增效，共赢AI时代。
      </p>
    </div>
  </section>

  <!-- CEO 引言区域 -->
  <section class="py-16 lg:py-24 border-t hairline">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <!-- 左侧图片：双层 Bezel 玻璃卡 -->
        <div class="grid grid-cols-2 gap-4">
          <div class="bezel transition-[box-shadow,transform] duration-500 ease-out-expo hover:-translate-y-1 hover:shadow-glow-sm" data-reveal data-spotlight>
            <div class="bezel-core overflow-hidden">
              <img
                src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=600&h=400&fit=crop"
                alt="团队协作"
                class="w-full h-64 object-cover"
              />
            </div>
          </div>
          <div class="bezel mt-8 transition-[box-shadow,transform] duration-500 ease-out-expo hover:-translate-y-1 hover:shadow-glow-sm" data-reveal data-spotlight style="--reveal-delay: 120ms;">
            <div class="bezel-core overflow-hidden">
              <img
                src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=600&h=400&fit=crop"
                alt="办公工作"
                class="w-full h-64 object-cover"
              />
            </div>
          </div>
        </div>

        <!-- 右侧引言 -->
        <div class="relative" data-reveal style="--reveal-delay: 240ms;">
          <!-- 引号装饰 -->
          <div class="absolute -top-4 -left-4 text-8xl text-white/[0.06] font-serif leading-none select-none" aria-hidden="true">"</div>

          <div class="relative z-10">
            <!-- CEO 信息：头像双层 Bezel + 绿色辉光 -->
            <div class="flex items-center gap-4 mb-6">
              <div class="relative shrink-0">
                <div class="absolute -inset-1.5 rounded-full bg-primary-500/20 blur-lg" aria-hidden="true"></div>
                <div class="relative w-16 h-16 rounded-full p-1 bg-white/[0.05] shadow-[0_0_0_1px_rgba(255,255,255,0.08)]">
                  <div class="w-full h-full rounded-full overflow-hidden bg-void-panel shadow-glow-sm">
                    <img
                      src="/images/founder.jpg"
                      alt={about.name}
                      class="w-full h-full object-cover object-top"
                      style="transform: rotate(-10deg) scale(1.25)"
                    />
                  </div>
                </div>
              </div>
              <div>
                <h3 class="font-semibold text-fg">{about.name}</h3>
                <p class="text-sm text-fg-faint font-mono">{about.title}</p>
              </div>
            </div>

            <!-- 引言内容 -->
            <p class="text-lg text-fg-soft leading-relaxed">
              {about.quote}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 客户 Logo -->
  <section class="py-16 lg:py-24 border-t hairline">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <SectionTitle title="我们的团队来自" subtitle="Team" index="01" centered>
          核心成员均来自一线互联网公司，拥有丰富的技术经验与行业资源
        </SectionTitle>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 lg:gap-6">
          {companies.map((name, i) => (
            <div
              class="bezel transition-[box-shadow,transform] duration-500 ease-out-expo hover:-translate-y-1 hover:shadow-glow-sm"
              data-reveal
              data-spotlight
              style={`--reveal-delay: ${i * 120}ms;`}
            >
              <div class="bezel-core p-6 text-center">
                <div class="text-3xl lg:text-4xl font-bold text-fg font-display">{name}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 核心价值观 -->
  <section class="relative py-16 lg:py-24 border-t hairline overflow-hidden">
    <div class="orb orb-primary -top-64 -right-64 w-[40rem] h-[40rem] opacity-60" aria-hidden="true"></div>
    <div class="container-custom relative">
      <SectionTitle title="我们的优势" subtitle="Values" index="02" centered>
        AI驱动开发，高效交付，助力企业在AI时代领先发展。
      </SectionTitle>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        {values.map((value, i) => (
          <div
            class="bezel transition-[box-shadow,transform] duration-500 ease-out-expo hover:-translate-y-1.5 hover:shadow-glow-sm"
            data-reveal
            data-spotlight
            style={`--reveal-delay: ${i * 120}ms;`}
          >
            <div class="bezel-core p-8 text-center">
              <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-primary-500/10 border border-primary-500/20 flex items-center justify-center text-primary-400">
                {value.icon === 'innovation' && (
                  <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                  </svg>
                )}
                {value.icon === 'integrity' && (
                  <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                )}
                {value.icon === 'customer' && (
                  <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                )}
              </div>
              <h3 class="text-xl font-semibold text-fg mb-3">{value.title}</h3>
              <p class="text-fg-faint leading-relaxed">{value.description}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- 统计数字：滚动计数 -->
      <div class="grid grid-cols-3 gap-8 mt-16 pt-16 border-t hairline">
        {stats.map((stat, i) => {
          const parsed = parseStat(stat.value);
          return (
            <div class="text-center" data-reveal style={`--reveal-delay: ${i * 120}ms;`}>
              <div class="text-4xl lg:text-5xl font-bold text-fg font-display mb-2">
                {parsed ? (
                  <span data-stat data-count-to={parsed.num} data-count-suffix={parsed.suffix}>{stat.value}</span>
                ) : (
                  <span data-stat>{stat.value}</span>
                )}
              </div>
              <p class="text-fg-faint">{stat.label}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 技术栈展示 -->
  <section class="py-16 lg:py-24 border-t hairline">
    <div class="container-custom">
      <SectionTitle title="技术栈" subtitle="Tech Stack" index="03" centered>
        多语言、多框架的技术储备
      </SectionTitle>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {techStack.map((group, i) => (
          <div
            class="bezel transition-[box-shadow,transform] duration-500 ease-out-expo hover:-translate-y-1 hover:shadow-glow-sm"
            data-reveal
            data-spotlight
            style={`--reveal-delay: ${i * 120}ms;`}
          >
            <div class="bezel-core overflow-hidden">
              <!-- 分组标题 -->
              <div class="flex items-center justify-between px-5 py-4 bg-white/[0.03] border-b border-white/10">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-lg bg-primary-500/10 border border-primary-500/20 flex items-center justify-center text-primary-400">
                    {group.icon === 'web' && (
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
                    )}
                    {group.icon === 'mobile' && (
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                    )}
                    {group.icon === 'cli' && (
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    )}
                  </div>
                  <span class="text-sm font-semibold text-fg">{group.name}</span>
                </div>
                <span class="font-mono text-xs px-2 py-1 rounded-full bg-primary-500/10 border border-primary-500/20 text-primary-400">{group.percent}%</span>
              </div>
              <!-- 语言列表：font-mono 玻璃胶囊 -->
              <div class="px-5 py-3 border-b border-white/10">
                <div class="flex flex-wrap gap-1.5">
                  {group.languages.map((lang) => (
                    <span class="font-mono text-xs px-2.5 py-1 rounded-full bg-white/[0.05] border border-white/10 text-fg-soft">{lang}</span>
                  ))}
                </div>
              </div>
              <!-- 框架列表：font-mono 玻璃胶囊 -->
              <div class="px-5 py-4">
                <div class="flex flex-wrap gap-2">
                  {group.frameworks.map((fw) => (
                    <span class="inline-flex items-center gap-1.5 font-mono text-xs px-3 py-1.5 rounded-full bg-white/[0.05] border border-white/10 text-fg-soft">
                      <svg class="w-3 h-3 text-primary-500/70" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                      {fw}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 业务方向 -->
  <section class="py-16 lg:py-24 border-t hairline">
    <div class="container-custom">
      <SectionTitle title="业务方向" subtitle="Business" index="04" centered>
        AI Agent工具开发与多智能体编排
      </SectionTitle>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div data-reveal>
          <Card class="h-full text-center">
            <div class="w-12 h-12 rounded-xl bg-primary-500/10 border border-primary-500/20 flex items-center justify-center mx-auto mb-4 text-primary-400">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-fg mb-2">AI Agent 开发</h3>
            <p class="text-sm text-fg-faint leading-relaxed">开发智能、高效的AI Agent工具，自动化处理各类业务场景</p>
          </Card>
        </div>

        <div data-reveal style="--reveal-delay: 120ms;">
          <Card class="h-full text-center">
            <div class="w-12 h-12 rounded-xl bg-primary-500/10 border border-primary-500/20 flex items-center justify-center mx-auto mb-4 text-primary-400">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-fg mb-2">Agent Team 编排</h3>
            <p class="text-sm text-fg-faint leading-relaxed">多智能体协同编排，构建复杂的AI工作流</p>
          </Card>
        </div>

        <div data-reveal style="--reveal-delay: 240ms;">
          <Card class="h-full text-center">
            <div class="w-12 h-12 rounded-xl bg-primary-500/10 border border-primary-500/20 flex items-center justify-center mx-auto mb-4 text-primary-400">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-fg mb-2">企业数字化咨询</h3>
            <p class="text-sm text-fg-faint leading-relaxed">帮助企业规划AI转型路径，实现降本增效</p>
          </Card>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ 区域 -->
  <section class="relative py-16 lg:py-24 border-t hairline overflow-hidden">
    <div class="orb orb-teal -bottom-64 -left-64 w-[36rem] h-[36rem]" aria-hidden="true"></div>
    <div class="container-custom relative">
      <SectionTitle title="常见问答" subtitle="FAQ" index="05" centered>
        了解我们的服务与合作方式
      </SectionTitle>

      <div class="space-y-4 max-w-3xl mx-auto">
        {faqs.map((faq, index) => (
          <div
            class="rounded-2xl bg-white/[0.04] border border-white/10 overflow-hidden faq-item transition-colors duration-300"
            data-reveal
            style={`--reveal-delay: ${index * 60}ms;`}
          >
            <button
              class="w-full px-6 py-5 text-left flex items-center justify-between gap-4 hover:bg-white/[0.04] transition-colors duration-300 faq-trigger"
              data-index={index}
            >
              <span class="font-medium text-fg">{index + 1}. {faq.question}</span>
              <svg class="w-5 h-5 text-fg-ghost flex-shrink-0 faq-icon transition-transform duration-300 ease-out-expo" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="faq-content hidden px-6 pb-5">
              <p class="text-fg-faint leading-relaxed">{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA 区域 -->
  <section class="py-16 lg:py-24 border-t hairline">
    <div class="container-custom">
      <div class="bezel" data-reveal>
        <div class="bezel-core relative overflow-hidden p-12 lg:p-16 text-center">
          <div class="absolute inset-0 bg-grid-dark pointer-events-none" aria-hidden="true"></div>
          <div class="orb orb-primary -top-40 left-1/2 -translate-x-1/2 w-[36rem] h-[22rem]" aria-hidden="true"></div>
          <div class="relative z-10">
            <p class="eyebrow mb-6">
              <span class="w-1.5 h-1.5 rounded-full bg-primary-500"></span>
