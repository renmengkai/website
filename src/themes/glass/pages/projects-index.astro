---
import Layout from '../Layout.astro';
import Button from '../components/ui/Button.astro';
---

<Layout
  title="作品 - RMK"
  description="展示我参与或独立完成的项目作品"
>
  <!-- 页面标题区 -->
  <section class="relative pt-32 pb-16 lg:pb-20 overflow-hidden">
    <div class="absolute inset-0 bg-grid-dark pointer-events-none" aria-hidden="true"></div>
    <div class="orb orb-primary -top-40 left-1/2 -translate-x-1/2 w-[48rem] h-[30rem]" aria-hidden="true"></div>
    <div class="container-custom relative text-center">
      <p class="eyebrow mb-8" data-reveal>Projects · 实践</p>
      <h1 class="text-display-lg font-bold text-fg mb-6" data-reveal-lines>
        <span class="reveal-line"><span style="--line-index: 1;">精选作品与项目</span></span>
      </h1>
      <p class="text-lg text-fg-faint max-w-2xl mx-auto" data-reveal style="--reveal-delay: 300ms;">
        展示我独立完成或参与的项目，从创意构思到技术实现的完整历程
      </p>
    </div>
  </section>

  <!-- 搜索栏 -->
  <section class="pb-4 mt-2">
    <div class="container-custom">
      <div class="max-w-xl mx-auto" data-reveal style="--reveal-delay: 420ms;">
        <div class="relative">
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-fg-ghost pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="text"
            id="search-input"
            placeholder="搜索项目名称..."
            class="input-dark rounded-full pl-12"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 分类筛选 -->
  <section class="pb-8">
    <div class="container-custom">
      <div id="category-filters" class="flex flex-wrap items-center justify-center gap-3" data-reveal style="--reveal-delay: 520ms;">
        <!-- 分类按钮将通过 JS 动态加载 -->
        <div class="h-10 w-16 bg-white/[0.07] rounded-full animate-pulse" aria-hidden="true"></div>
        <div class="h-10 w-20 bg-white/[0.05] rounded-full animate-pulse" aria-hidden="true"></div>
        <div class="h-10 w-24 bg-white/[0.05] rounded-full animate-pulse" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <!-- 项目列表 -->
  <section class="pb-24">
    <div class="container-custom">
      <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        <!-- 骨架屏加载状态 -->
        {[1,2,3,4,5,6].map(() => (
          <div class="bezel animate-pulse" aria-hidden="true">
            <div class="bezel-core overflow-hidden">
              <div class="aspect-video bg-white/[0.04]"></div>
              <div class="p-6">
                <div class="h-6 bg-white/[0.06] rounded w-3/4 mb-2"></div>
                <div class="h-4 bg-white/[0.05] rounded w-full mb-1"></div>
                <div class="h-4 bg-white/[0.05] rounded w-2/3 mb-4"></div>
                <div class="flex gap-2">
                  <div class="h-6 w-16 bg-white/[0.05] rounded-full"></div>
                  <div class="h-6 w-20 bg-white/[0.05] rounded-full"></div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA 区域 -->
  <section class="py-20 lg:py-28 border-t hairline relative overflow-hidden">
    <div class="orb orb-teal -bottom-48 -right-48 w-[36rem] h-[36rem]" aria-hidden="true"></div>
    <div class="container-custom relative">
      <div class="bezel" data-reveal data-spotlight>
        <div class="bezel-core p-10 lg:p-16">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div>
              <p class="eyebrow mb-6">Contact</p>
              <h2 class="text-heading-xl lg:text-display font-bold text-fg mb-4">
                有项目想法？
              </h2>
              <p class="text-fg-faint leading-relaxed mb-8 max-w-md">
                我始终乐于讨论新项目、创意想法，或参与您的愿景。让我们一起创造一些不可思议的事物。
              </p>
              <Button href="/about" variant="primary" showArrow magnetic>
                联系我
              </Button>
            </div>
            <div class="flex justify-center lg:justify-end">
              <div class="grid grid-cols-2 gap-4">
                <div class="bg-white/[0.04] border border-white/10 rounded-2xl p-6 text-center" data-reveal style="--reveal-delay: 120ms;">
                  <div class="text-3xl font-bold font-display text-fg mb-1" data-count-to="50" data-count-suffix="+">50+</div>
                  <p class="text-sm text-fg-faint">已完成项目</p>
                </div>
                <div class="bg-white/[0.04] border border-white/10 rounded-2xl p-6 text-center" data-reveal style="--reveal-delay: 240ms;">
                  <div class="text-3xl font-bold font-display text-fg mb-1" data-count-to="100" data-count-suffix="%">100%</div>
                  <p class="text-sm text-fg-faint">客户满意度</p>
                </div>
                <div class="bg-white/[0.04] border border-white/10 rounded-2xl p-6 text-center" data-reveal style="--reveal-delay: 360ms;">
                  <div class="text-3xl font-bold font-display text-fg mb-1" data-count-to="10" data-count-suffix="+">10+</div>
                  <p class="text-sm text-fg-faint">年经验</p>
                </div>
                <div class="bg-primary-500/10 border border-primary-500/25 rounded-2xl p-6 text-center" data-reveal style="--reveal-delay: 480ms;">
                  <div class="text-3xl font-bold font-display text-primary-400 mb-1" data-count-to="24" data-count-suffix="*7">24*7</div>
                  <p class="text-sm text-fg-soft">支持可用</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  // 共享 Sanity 配置 - 使用 window 对象避免重复声明
  window.SANITY_PROJECT_ID = window.SANITY_PROJECT_ID || 'k2j30muc';
  window.SANITY_DATASET = window.SANITY_DATASET || 'production';

  // projects 页面专用的 fetch 函数
  async function fetchSanityProjects(query) {
    const url = `https://${window.SANITY_PROJECT_ID}.api.sanity.io/v2024-01-01/data/query/${window.SANITY_DATASET}?query=${encodeURIComponent(query)}`;
    const res = await fetch(url);
    const data = await res.json();
    return data.result;
  }

  // 使用 astro:page-load 事件确保 View Transitions 导航后也能执行
  document.addEventListener('astro:page-load', () => {
    // 只在 projects 列表页执行
    if (window.location.pathname !== '/projects' && window.location.pathname !== '/projects/') return;

    let projects = [];
    let categories = [];
    let selectedCategory = '';
    let searchKeyword = '';

    const projectsGrid = document.getElementById('projects-grid');
    const categoryFilters = document.getElementById('category-filters');
    const searchInput = document.getElementById('search-input');

    if (!projectsGrid || !categoryFilters) return;

    // 生成项目卡片 HTML（深色 Bezel 玻璃卡）
    function createProjectHtml(project, i = 0) {
      const cats = (project.categories || []).filter(c => c).slice(0, 2).map(c =>
        `<span class="inline-block px-2.5 py-1 rounded-full text-xs font-medium font-mono bg-white/[0.05] text-fg-soft border border-white/10">${c.title}</span>`
      ).join('');
      const slugValue = project.slug?.current || project.slug;
      const delay = Math.min(i, 8) * 90;

      return `<a href="/projects/${slugValue}" data-astro-prefetch="hover" data-reveal style="--reveal-delay: ${delay}ms" class="group block bezel transition-[box-shadow,transform] duration-500 ease-out-expo hover:-translate-y-1.5 hover:shadow-glow-sm">
        <div class="bezel-core overflow-hidden">
          <div class="relative aspect-video bg-white/[0.03] overflow-hidden">
            ${project.thumbnail ? `<img src="${project.thumbnail}" alt="${project.title}" class="w-full h-full object-cover transition-transform duration-700 ease-out-expo group-hover:scale-[1.06]" loading="lazy"/>` : ''}
            <div class="absolute inset-x-0 bottom-0 h-12 bg-gradient-to-t from-void-panel/70 to-transparent pointer-events-none" aria-hidden="true"></div>
          </div>
          <div class="p-6">
            <h3 class="text-lg font-semibold text-fg mb-2 transition-colors duration-300 group-hover:text-primary-400">${project.title}</h3>
            <p class="text-fg-faint text-sm leading-relaxed mb-4 line-clamp-2">${project.description || ''}</p>
            <div class="flex flex-wrap gap-2">${cats}</div>
          </div>
        </div>
      </a>`;
    }

    // JS 注入的卡片不在 motion.ts 的 IntersectionObserver 里，这里手动触发入场（纯视觉）
    function revealInjectedCards() {
      const cards = projectsGrid.querySelectorAll('[data-reveal]');
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          cards.forEach(el => {
            el.classList.add('is-visible');
            // 入场结束后移除 data-reveal，避免其过渡延迟干扰 hover
            setTimeout(() => el.removeAttribute('data-reveal'), 2000);
          });
        });
      });
    }

    // 渲染分类筛选按钮（玻璃胶囊，激活态绿色实心）
    function renderCategories() {
      const allCats = [{ title: '全部', slug: '' }, ...categories.filter(c => c.slug).map(c => ({ title: c.title, slug: c.slug }))];
      categoryFilters.innerHTML = allCats.map(cat => {
        const isActive = cat.slug === selectedCategory;
        return `<button data-category="${cat.slug}" class="px-4 py-2 rounded-full text-sm font-medium transition-colors duration-300 ${isActive ? 'bg-primary-500 text-void border border-primary-500' : 'bg-white/[0.04] text-fg-soft border border-white/10 hover:bg-white/[0.08] hover:text-fg hover:border-white/20'}">${cat.title}</button>`;
      }).join('');
    }

    // 筛选项目
    function filterProjects() {
      const filtered = projects.filter(p => {
        const matchCategory = !selectedCategory || p.categories?.some(c => (c.slug?.current || c.slug) === selectedCategory);
        const matchSearch = !searchKeyword || p.title.toLowerCase().includes(searchKeyword.toLowerCase());
        return matchCategory && matchSearch;
      });

      projectsGrid.innerHTML = filtered.length
        ? filtered.map(createProjectHtml).join('')
        : '<div class="col-span-full text-center py-12"><p class="text-fg-faint">没有找到匹配的项目</p></div>';

      revealInjectedCards();
    }

    // 分类筛选按钮事件
    categoryFilters.addEventListener('click', e => {
      const btn = e.target.closest('button');
      if (btn && btn.dataset.category !== undefined) {
        selectedCategory = btn.dataset.category;
        renderCategories();
        filterProjects();
      }
    });

    // 搜索功能（防抖）
    let searchTimeout;
    searchInput?.addEventListener('input', e => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        searchKeyword = e.target.value.trim();
        filterProjects();
      }, 300);
    });

    // 异步加载数据
    async function loadData() {
      const projectsQuery = `*[_type == "project"] | order(order asc) {
        _id, title, slug, description,
        "thumbnail": thumbnail.asset->url,
        categories[]->{title, "slug": slug.current},
        technologies, featured
      }`;
      const categoriesQuery = `*[_type == "category" && (usedFor == "projects" || usedFor == "both")] | order(title asc) { _id, title, "slug": slug.current }`;

      [projects, categories] = await Promise.all([fetchSanityProjects(projectsQuery), fetchSanityProjects(categoriesQuery)]);

      renderCategories();
      filterProjects();
    }

    loadData();
  });
</script>
