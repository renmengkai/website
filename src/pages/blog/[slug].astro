---
import { getDesign } from '../../lib/design';
import { fetchSanity, postBySlugQuery } from '../../lib/sanity';
import VimaBlogDetail from '../../themes/vima/pages/blog-detail.astro';
import GlassBlogDetail from '../../themes/glass/pages/blog-detail.astro';

const { slug } = Astro.params;
const post = await fetchSanity<any>(postBySlugQuery, { slug });

// 文章不存在 → 404 状态码，由主题组件渲染对应的未找到状态
if (!post) {
  Astro.response.status = 404;
}

const design = getDesign(Astro.cookies);
---

{design === 'glass' ? <GlassBlogDetail post={post} /> : <VimaBlogDetail post={post} />}
