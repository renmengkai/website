---
import { getDesign } from '../../lib/design';
import { fetchSanity, projectBySlugQuery } from '../../lib/sanity';
import VimaProjectDetail from '../../themes/vima/pages/project-detail.astro';
import GlassProjectDetail from '../../themes/glass/pages/project-detail.astro';

const { slug } = Astro.params;
const project = await fetchSanity<any>(projectBySlugQuery, { slug });

// 项目不存在 → 404
if (!project) {
  return Astro.redirect('/404');
}

const design = getDesign(Astro.cookies);
---

{design === 'glass' ? <GlassProjectDetail project={project} /> : <VimaProjectDetail project={project} />}
