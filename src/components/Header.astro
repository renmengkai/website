---
// Header 组件 - 按 claude.ai/design 原型（页头.dc.html）实现

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: '首页' },
  { href: '/blog', label: '博客' },
  { href: '/projects', label: '作品' },
  { href: '/about', label: '关于' },
];

// 判断当前路径是否匹配导航项
function isActive(href: string): boolean {
  if (href === '/') {
    return currentPath === '/';
  }
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 bg-paper/90 backdrop-blur-md border-b border-line" id="main-header">
  <div class="container-page">
    <nav class="flex items-center justify-between gap-6 h-[68px]">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 flex-none hover:opacity-80 transition-opacity">
        <img src="/images/logo-lockup.png" alt="vima tech" class="h-9 block" />
      </a>

      <!-- 桌面端导航 -->
      <div class="hidden md:flex items-center gap-[34px] text-[15px]">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`relative flex flex-col items-center gap-0.5 px-0.5 py-1 transition-colors duration-200 hover:text-brand
              ${isActive(link.href)
                ? 'text-ink font-semibold'
                : 'text-[#7B7369] font-normal'
              }`}
          >
            <span>{link.label}</span>
            <span class={`logo-wave block flex-none w-[26px] h-1.5 bg-brand transition-opacity ${isActive(link.href) ? 'opacity-100' : 'opacity-0'}`}></span>
          </a>
        ))}
      </div>

      <!-- 右侧操作区 -->
      <div class="flex items-center gap-4">
        <!-- 设计切换按钮（切换到深色 glass 设计） -->
        <button
          type="button"
          class="hidden sm:flex w-9 h-9 rounded-lg border border-line text-stone hover:border-brand hover:text-brand transition-colors items-center justify-center"
          aria-label="切换到深色设计"
          onclick="document.cookie='design=glass;path=/;max-age=31536000;samesite=lax';location.reload()"
        >
          <svg class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </button>

        <!-- CTA 按钮 -->
        <a
          href="/contact"
          class="hidden sm:inline-flex flex-none items-center bg-brand text-white px-5 py-2.5 rounded-lg text-sm font-medium tracking-[0.02em] hover:bg-brand-dark transition-colors"
        >
          联系我们
        </a>

        <!-- 移动端菜单按钮 -->
        <button
          class="md:hidden p-2 rounded-lg hover:bg-cream transition-colors"
          id="mobile-menu-btn"
          aria-label="打开菜单"
        >
          <svg class="w-6 h-6 text-clay" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </nav>
  </div>

  <!-- 移动端菜单 -->
  <div
    class="md:hidden fixed inset-0 z-50 hidden"
    id="mobile-menu"
  >
    <div class="absolute inset-0 bg-ink/20 backdrop-blur-sm" id="mobile-menu-overlay"></div>
    <div class="absolute right-0 top-0 bottom-0 w-72 bg-paper shadow-xl transform transition-transform duration-300 translate-x-full" id="mobile-menu-panel">
      <div class="p-6">
        <div class="flex items-center justify-between mb-8">
          <img src="/images/logo-lockup.png" alt="vima tech" class="h-8" />
          <button
            class="p-2 rounded-lg hover:bg-cream transition-colors"
            id="mobile-menu-close"
            aria-label="关闭菜单"
          >
            <svg class="w-5 h-5 text-stone" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <nav class="space-y-1">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class={`flex items-center justify-between px-4 py-3 rounded-xl text-base transition-colors
                ${isActive(link.href)
                  ? 'text-ink bg-cream font-semibold'
                  : 'text-[#7B7369] font-normal hover:bg-cream/60 hover:text-ink'
                }`}
            >
              <span>{link.label}</span>
              {isActive(link.href) && (
                <span class="logo-wave block flex-none w-[26px] h-1.5 bg-brand"></span>
              )}
            </a>
          ))}
        </nav>

        <!-- 移动端 CTA -->
        <div class="mt-8 pt-8 border-t border-line-soft">
          <a
            href="/contact"
            class="flex items-center justify-center w-full bg-brand text-white px-5 py-3 rounded-lg text-sm font-medium tracking-[0.02em] hover:bg-brand-dark transition-colors"
          >
            联系我们
          </a>

          <!-- 设计切换按钮（切换到深色 glass 设计） -->
          <div class="mt-4 flex items-center justify-between px-1">
            <span class="text-[13px] text-stone">切换到深色设计</span>
            <button
              type="button"
              class="w-9 h-9 rounded-lg border border-line text-stone hover:border-brand hover:text-brand transition-colors flex items-center justify-center"
              aria-label="切换到深色设计"
              onclick="document.cookie='design=glass;path=/;max-age=31536000;samesite=lax';location.reload()"
            >
              <svg class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  // 移动端菜单
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const menuPanel = document.getElementById('mobile-menu-panel');
  const menuClose = document.getElementById('mobile-menu-close');
  const menuOverlay = document.getElementById('mobile-menu-overlay');

  const openMenu = () => {
    menu?.classList.remove('hidden');
    setTimeout(() => {
      menuPanel?.classList.remove('translate-x-full');
    }, 10);
  };

  const closeMenu = () => {
    menuPanel?.classList.add('translate-x-full');
    setTimeout(() => {
      menu?.classList.add('hidden');
    }, 300);
  };

  menuBtn?.addEventListener('click', openMenu);
  menuClose?.addEventListener('click', closeMenu);
  menuOverlay?.addEventListener('click', closeMenu);
</script>
