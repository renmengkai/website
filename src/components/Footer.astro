---
// Footer 组件 - 按 claude.ai/design 原型（页脚.dc.html）实现
const currentYear = new Date().getFullYear();

const footerLinks = [
  { href: '/blog', label: '博客' },
  { href: '/projects', label: '作品' },
  { href: '/about', label: '关于' },
];
---

<footer class="bg-paper border-t border-line">
  <div class="container-page pt-12 pb-10">
    <!-- 上部分 - Logo 简介 和导航 -->
    <div class="flex flex-wrap items-start justify-between gap-8">
      <div class="flex flex-col gap-3.5">
        <a href="/" class="self-start">
          <img src="/images/logo-lockup.png" alt="vima tech" class="h-8 w-auto block" />
        </a>
        <p class="m-0 text-[13px] text-stone max-w-xs leading-relaxed">
          AI Agent 驱动的开发团队 · 80% 工作由 AI Agent 完成
        </p>
      </div>

      <nav class="flex gap-7 text-sm pt-1.5">
        {footerLinks.map((link) => (
          <a
            href={link.href}
            class="text-[#7B7369] hover:text-brand transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <!-- 下部分 - 版权和社交链接 -->
    <div class="mt-9 pt-5 border-t border-line-soft flex flex-wrap items-center justify-between gap-4">
      <span class="font-mono text-xs text-mist">
        © {currentYear} vima tech · 冀ICP备XXXXXXXX号
      </span>

      <a
        href="https://github.com/renmengkai"
        target="_blank"
        rel="noopener"
        aria-label="GitHub"
        class="flex items-center gap-2 text-[13px] text-[#7B7369] hover:text-brand transition-colors"
      >
        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
        <span>GitHub</span>
      </a>
    </div>
  </div>
</footer>
